<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="IOpenPod.WinUI.Styles.Theme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:IOpenPod.WinUI.ViewModels">

    <!-- 卡片容器 -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 曲目列表行 -->
    <DataTemplate x:Key="TrackRowTemplate" x:DataType="vm:TrackRow">
        <Grid ColumnSpacing="12" Padding="4,6,4,6" ToolTipService.ToolTip="{x:Bind DetailText}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="1.2*" MinWidth="120" />
                <ColumnDefinition Width="1.2*" MinWidth="120" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind NumberText}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="5"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>

            <TextBlock Grid.Column="2" Text="{x:Bind Title}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />

            <TextBlock Grid.Column="3" Text="{x:Bind Artist}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />

            <TextBlock Grid.Column="4" Text="{x:Bind Album}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />

            <TextBlock Grid.Column="5" Text="{x:Bind RatingText}" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />

            <TextBlock Grid.Column="6" Text="{x:Bind SizeText}" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Grid.Column="7" Text="{x:Bind DurationText}" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </DataTemplate>

    <!-- 专辑卡片 -->
    <DataTemplate x:Key="AlbumCardTemplate" x:DataType="vm:AlbumCard">
        <Grid Width="176" Margin="4" CornerRadius="8" Padding="8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Width="160" Height="160" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <TextBlock Grid.Row="1" Text="{x:Bind AlbumName}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock Grid.Row="2" Text="{x:Bind MetaText}" Style="{StaticResource MutedTextStyle}" MaxLines="1" />
        </Grid>
    </DataTemplate>

    <!-- 艺术家 / 流派行 -->
    <DataTemplate x:Key="GroupRowTemplate" x:DataType="vm:GroupRow">
        <Grid ColumnSpacing="12" Padding="4,6,4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
            </Border>
            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock Grid.Column="2" Text="{x:Bind Meta}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </DataTemplate>

    <!-- 同步变更项 -->
    <DataTemplate x:Key="SyncChangeTemplate" x:DataType="vm:SyncChangeRow">
        <Grid ColumnSpacing="10" Padding="4,6,4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" />
            <TextBlock Grid.Column="1" Text="{x:Bind KindText}" VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" MaxLines="1" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- 备份快照 -->
    <DataTemplate x:Key="BackupRowTemplate" x:DataType="vm:BackupRow">
        <Grid ColumnSpacing="10" Padding="4,8,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE753;" FontSize="16"
                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind Path}" Style="{StaticResource MutedTextStyle}" MaxLines="1" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- 日志行 -->
    <DataTemplate x:Key="LogRowTemplate" x:DataType="vm:LogRow">
        <Grid ColumnSpacing="10" Padding="4,3,4,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind Time}" FontFamily="Consolas"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Level}" FontFamily="Consolas"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="{x:Bind Category}" FontFamily="Consolas"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock Grid.Column="3" Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
