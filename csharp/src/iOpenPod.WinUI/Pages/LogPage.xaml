<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="运行日志" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="LogPathText" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8">
                <Button Click="OnOpenFolderClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="13" />
                        <TextBlock Text="打开日志目录" />
                    </StackPanel>
                </Button>
                <Button Click="OnCopyClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                        <TextBlock Text="复制全部" />
                    </StackPanel>
                </Button>
                <Button Click="OnClearClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="清空显示" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="LevelBox" Grid.Column="0" Width="130" SelectionChanged="OnFilterChanged" />
            <TextBox x:Name="FilterBox" Grid.Column="1" Width="240" PlaceholderText="按关键字或分类筛选…"
                     TextChanged="OnFilterTextChanged" />
            <CheckBox x:Name="AutoScrollCheck" Grid.Column="2" Content="自动滚动到最新" IsChecked="True"
                      HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8">
            <ListView x:Name="LogList" ItemTemplate="{StaticResource LogRowTemplate}" SelectionMode="Single" />
        </Border>
    </Grid>
</Page>
