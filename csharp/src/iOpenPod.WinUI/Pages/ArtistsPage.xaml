<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="艺术家" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" Text="尚未加载设备。" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="BackButton" Click="OnBackClick" Visibility="Collapsed"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    <TextBlock Text="返回艺术家列表" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="GroupList" Grid.Row="1" ItemTemplate="{StaticResource GroupRowTemplate}"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnGroupClick" />

        <Grid x:Name="DetailPanel" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailMeta" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>
            <ListView x:Name="DetailTracks" Grid.Row="1" ItemTemplate="{StaticResource TrackRowTemplate}"
                      SelectionMode="Extended" IsItemClickEnabled="True" DoubleTapped="OnTrackDoubleTapped">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="立即播放" Click="OnTrackPlayClick" />
                        <MenuFlyoutItem Text="添加到队列" Click="OnTrackEnqueueClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="编辑信息" Click="OnTrackEditClick" />
                        <MenuFlyoutItem Text="从 iPod 移除" Click="OnTrackRemoveClick" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
        </Grid>
    </Grid>
</Page>
