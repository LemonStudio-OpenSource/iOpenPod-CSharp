<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.TracksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="歌曲" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" Text="尚未加载设备。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Click="OnPlaySelectedClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock Text="播放选中" />
                    </StackPanel>
                </Button>
                <Button Click="OnEditClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                        <TextBlock Text="编辑信息" />
                    </StackPanel>
                </Button>
                <Button Click="OnExportClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="13" />
                        <TextBlock Text="导出到电脑" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索标题、艺术家、专辑、作曲者或流派…"
                     TextChanged="OnSearchTextChanged" />
            <ComboBox x:Name="SortBox" Grid.Column="1" Width="150" SelectionChanged="OnSortChanged" />
            <ToggleButton x:Name="SortDirectionToggle" Grid.Column="2" Click="OnSortDirectionClick"
                          ToolTipService.ToolTip="切换升序/降序">
                <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74A;" FontSize="13" />
            </ToggleButton>
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="TrackList" ItemTemplate="{StaticResource TrackRowTemplate}"
                      SelectionMode="Extended" IsItemClickEnabled="True"
                      DoubleTapped="OnTrackDoubleTapped"
                      SelectionChanged="OnTrackSelectionChanged">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="立即播放" Click="OnPlaySelectedClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="下一首播放" Click="OnPlayNextClick" />
                        <MenuFlyoutItem Text="添加到队列" Click="OnEnqueueClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="编辑信息" Click="OnEditClick" />
                        <MenuFlyoutItem Text="添加到播放列表…" Click="OnAddToPlaylistClick" />
                        <MenuFlyoutItem Text="导出到电脑…" Click="OnExportClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="从 iPod 移除" Click="OnRemoveClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="10" Visibility="Collapsed">
                <FontIcon Glyph="&#xE8D6;" FontSize="42"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyText" Text="还没有加载任何设备。" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
