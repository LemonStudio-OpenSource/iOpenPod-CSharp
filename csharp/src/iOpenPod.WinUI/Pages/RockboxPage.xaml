<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.RockboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Rockbox" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="把开源固件 Rockbox 安装到 iPod 上。系统文件安装是可逆的；引导程序安装会改写设备的固件分区，需要管理员权限。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="InspectButton" Click="OnInspectClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                        <TextBlock Text="刷新状态" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenRockboxSiteClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="13" />
                        <TextBlock Text="打开官网" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <controls:InfoBar x:Name="NoticeBar" Grid.Row="1" Margin="0,12,0,12"
                          IsOpen="False" IsClosable="True" Severity="Informational" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="940" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="设备与目标机型" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                        <TextBlock x:Name="TargetText" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="获取方式" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                        <TextBox x:Name="MirrorBox" Header="镜像站根地址"
                                 PlaceholderText="留空使用官方 https://download.rockbox.org" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ChannelBox" Grid.Column="0" Header="版本通道" Width="220"
                                      SelectionChanged="OnChannelChanged" />
                            <NumberBox x:Name="VersionBox" Grid.Column="1" Header="稳定版版本号" Width="180"
                                       Minimum="4" Maximum="99" SpinButtonPlacementMode="Compact"
                                       ValueChanged="OnVersionChanged" />
                        </Grid>
                        <TextBlock x:Name="DownloadUrlText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="安装参数" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                        <ComboBox x:Name="ModeBox" Header="安装模式" Width="420" SelectionChanged="OnModeChanged" />
                        <ToggleSwitch x:Name="BackupFirmwareSwitch" Header="安装前备份固件分区（ipodpatcher --read-partition）"
                                      OnContent="启用" OffContent="停用" Toggled="OnOptionToggled" />
                        <ToggleSwitch x:Name="BackupAppleSwitch" Header="安装前导出 Apple 固件（ipodpatcher --read-firmware）"
                                      OnContent="启用" OffContent="停用" Toggled="OnOptionToggled" />
                        <ToggleSwitch x:Name="DualBootSwitch" Header="保留 Apple 固件双启动（把 apple_os.ipod 放进 .rockbox）"
                                      OnContent="启用" OffContent="停用" Toggled="OnOptionToggled" />
                        <ToggleSwitch x:Name="BackupExistingSwitch" Header="覆盖前把已有的 .rockbox 打包备份"
                                      OnContent="启用" OffContent="停用" Toggled="OnOptionToggled" />
                        <ToggleSwitch x:Name="RemoveBootloaderSwitch" Header="卸载时同时移除引导程序"
                                      OnContent="启用" OffContent="停用" Toggled="OnOptionToggled" />
                        <TextBox x:Name="ExtraArgsBox" Header="附加给 ipodpatcher 的参数"
                                 PlaceholderText="例如 --add-bootloader-bin custom.bin" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="高级：可以指定自备的文件，跳过下载。路径留空表示自动下载。" />
                        <TextBox x:Name="CustomSystemZipBox" Header="自备系统文件 ZIP 路径" />
                        <TextBox x:Name="CustomBootloaderBox" Header="自备引导程序文件路径" />
                        <TextBox x:Name="CustomIpodpatcherBox" Header="自备 ipodpatcher.exe 路径" />
                        <TextBox x:Name="Mks5lbootBox" Header="mks5lboot 路径（仅 iPod classic 需要）" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="执行" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RunButton" Click="OnRunClick" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                    <TextBlock x:Name="RunButtonText" Text="开始安装" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelButton" Click="OnCancelClick" IsEnabled="False">
                                <TextBlock Text="取消" />
                            </Button>
                            <Button Click="OnOpenBackupFolderClick">
                                <TextBlock Text="打开备份目录" />
                            </Button>
                        </StackPanel>
                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="执行步骤" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <ListView x:Name="StepList" Height="220" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Padding="2,4,2,4"
                                               IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="说明与风险" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Text="• 只安装系统文件（解压 rockbox-*.zip 到设备根目录）不会改动固件，随时可以卸载。" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Text="• 安装引导程序会改写 iPod 的固件分区。虽然不会造成永久损坏，但失败后通常需要用 iTunes 恢复并格式化设备。" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Text="• iPod classic（6/6.5/7 代）不能用 ipodpatcher，必须用 mks5lboot 在 DFU 模式下写入，请使用 Rockbox Utility。" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Text="• iPod nano 2 代需要额外的固件加密步骤，官方建议使用 Rockbox Utility。" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Text="• Rockbox 采用 GPL 授权，与本程序相互独立；本程序只负责下载并调用 Rockbox 官方发布的安装工具。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
