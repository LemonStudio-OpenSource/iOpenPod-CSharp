<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:IOpenPod.WinUI.Pages">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="我的 iPod" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="发现、识别并加载通过 USB 连接、且文件系统可访问的 iPod。发现过程只读取，不会写入设备。" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8">
                <Button x:Name="RefreshButton" Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="重新扫描" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" Click="OnOpenClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="加载音乐库" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <controls:InfoBar x:Name="NoticeBar" Grid.Row="1" Margin="0,12,0,12"
                          IsOpen="False" IsClosable="True" Severity="Informational" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="检测到的设备" FontWeight="SemiBold" Margin="12,12,12,6" />
                    <ListView x:Name="DeviceList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="OnDeviceSelectionChanged" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DeviceItem">
                                <Grid ColumnSpacing="10" Padding="4,8,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <FontIcon Glyph="&#xE8EA;" FontSize="20"
                                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" MaxLines="2" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="12" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
