<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="这些设置只保存在这台电脑上，不会写入 iPod。" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ComboBox x:Name="ThemeBox" Header="应用主题" Width="260" SelectionChanged="OnThemeChanged" />
                    <ComboBox x:Name="ViewModeBox" Header="音乐库呈现方式" Width="260" SelectionChanged="OnViewModeChanged" />
                    <ComboBox x:Name="DoubleClickBox" Header="双击曲目的默认动作" Width="260"
                              SelectionChanged="OnDoubleClickChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="同步" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="SyncArtworkSwitch" Header="同步时把封面写入设备"
                                  OnContent="启用" OffContent="停用" Toggled="OnSyncArtworkToggled" />
                    <ToggleSwitch x:Name="BackupBeforeSyncSwitch" Header="同步前自动创建备份快照"
                                  OnContent="启用" OffContent="停用" Toggled="OnBackupBeforeSyncToggled" />
                    <ComboBox x:Name="TranscodeBox" Header="音频转码策略" Width="300"
                              SelectionChanged="OnTranscodeChanged" />
                    <NumberBox x:Name="BitrateBox" Header="转码目标码率（kbps）" Width="220" Minimum="64" Maximum="320"
                               SpinButtonPlacementMode="Compact" ValueChanged="OnBitrateChanged" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"
                               Text="说明：本版本默认“保持原格式”，不会重新编码媒体文件；设备原生不支持的格式会给出提示。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="备份" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupPathBox" Grid.Column="0" Header="备份目录" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="更改…" Click="OnChangeBackupPath" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="电源与设备" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="SystemMediaSwitch" Header="启用系统媒体控制（桌面播放控件）"
                                  OnContent="启用" OffContent="停用" Toggled="OnSystemMediaToggled" />
                    <ToggleSwitch x:Name="RememberWindowSwitch" Header="记住窗口位置与大小"
                                  OnContent="启用" OffContent="停用" Toggled="OnRememberWindowToggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="诊断" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="VerboseSwitch" Header="记录详细日志（调试）"
                                  OnContent="启用" OffContent="停用" Toggled="OnVerboseToggled" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开日志目录" Click="OnOpenLogFolder" />
                        <Button Content="恢复默认设置" Click="OnResetSettings" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <TextBlock Text="iOpenPod 管理器（C# / WinUI 3 重制版）" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="这是一个完全使用 C# 与 WinUI 3 重写的开源 iPod 管理工具，界面与日志均为中文。支持 iPod（第 1–5.5 代）、iPod classic、iPod mini 与 iPod nano 全系列的文件系统级管理。iPod shuffle、iPod touch 与 iPhone 不在支持范围内。" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="原始项目：https://github.com/TheRealSavi/iOpenPod　授权：GPL-3.0-or-later。iPod 与 iTunes 是 Apple Inc. 的商标，本软件与 Apple 无任何关联。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
