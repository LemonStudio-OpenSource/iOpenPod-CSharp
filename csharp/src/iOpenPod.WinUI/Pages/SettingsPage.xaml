<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="这些设置只保存在这台电脑上，不会写入 iPod。" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ComboBox x:Name="ThemeBox" Header="应用主题" Width="260" SelectionChanged="OnThemeChanged" />
                    <ComboBox x:Name="ViewModeBox" Header="音乐库呈现方式" Width="260" SelectionChanged="OnViewModeChanged" />
                    <ComboBox x:Name="DoubleClickBox" Header="双击曲目的默认动作" Width="260"
                              SelectionChanged="OnDoubleClickChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="同步" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="SyncArtworkSwitch" Header="同步时把封面写入设备"
                                  OnContent="启用" OffContent="停用" Toggled="OnSyncArtworkToggled" />
                    <ToggleSwitch x:Name="BackupBeforeSyncSwitch" Header="同步前自动创建备份快照"
                                  OnContent="启用" OffContent="停用" Toggled="OnBackupBeforeSyncToggled" />
                    <ComboBox x:Name="TranscodeBox" Header="音频转码策略" Width="300"
                              SelectionChanged="OnTranscodeChanged" />
                    <NumberBox x:Name="BitrateBox" Header="转码目标码率（kbps）" Width="220" Minimum="64" Maximum="320"
                               SpinButtonPlacementMode="Compact" ValueChanged="OnBitrateChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="媒体工具与转码" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <TextBlock x:Name="FfmpegStatusText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FfmpegPathBox" Grid.Column="0" Header="ffmpeg / ffprobe 所在目录"
                                 PlaceholderText="留空则自动在系统 PATH 中查找" />
                        <Button Grid.Column="1" Content="浏览…" Click="OnBrowseFfmpeg" VerticalAlignment="Bottom" />
                        <Button Grid.Column="2" Content="重新检测" Click="OnRedetectFfmpeg" VerticalAlignment="Bottom" />
                    </Grid>
                    <ToggleSwitch x:Name="AudioConversionSwitch" Header="设备不支持时自动重新编码音频"
                                  OnContent="启用" OffContent="停用" Toggled="OnAudioConversionToggled" />
                    <ToggleSwitch x:Name="VideoConversionSwitch" Header="设备不支持时自动重新编码视频"
                                  OnContent="启用" OffContent="停用" Toggled="OnVideoConversionToggled" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="VideoBitrateBox" Grid.Column="0" Header="视频码率（kbps）" Width="180"
                                   Minimum="200" Maximum="8000" SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnVideoBitrateChanged" />
                        <NumberBox x:Name="VideoWidthBox" Grid.Column="1" Header="最大宽度" Width="140"
                                   Minimum="160" Maximum="1920" SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnVideoSizeChanged" />
                        <NumberBox x:Name="VideoHeightBox" Grid.Column="2" Header="最大高度" Width="140"
                                   Minimum="120" Maximum="1080" SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnVideoSizeChanged" />
                    </Grid>
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="说明：转码需要系统上安装 FFmpeg（ffmpeg 与 ffprobe）。程序不会自行下载 FFmpeg。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="标签写回源文件" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="TagWriteSwitch" Header="同步后把元数据写回电脑上的源文件"
                                  OnContent="启用" OffContent="停用" Toggled="OnTagWriteToggled" />
                    <ToggleSwitch x:Name="TagBackupSwitch" Header="写回前创建 .iopenpod.bak 备份"
                                  OnContent="启用" OffContent="停用" Toggled="OnTagBackupToggled" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="说明：按源文件格式支持多少字段就写多少 —— ID3v2 支持标题/艺术家/专辑/流派/作曲者/备注/歌词/音轨号/碟号/年份/BPM/合辑/封面；FLAC 与 Ogg 支持 Vorbis 注释的全部字段；MP4 支持 iTunes 风格字段；WAV/AIFF 支持 INFO/NAME/AUTH/ANNO。无法表达的字段会在结果中列出。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Rockbox" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="AutoRockboxSwitch" Header="同步时自动尝试安装 Rockbox"
                                  OnContent="启用" OffContent="停用" Toggled="OnAutoRockboxToggled" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="说明：只在设备上还没有 Rockbox 时执行，且默认只安装系统文件（可逆）。引导程序安装请到左侧“Rockbox”页面手动进行。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="备份" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupPathBox" Grid.Column="0" Header="备份目录" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="更改…" Click="OnChangeBackupPath" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="电源与设备" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="SystemMediaSwitch" Header="启用系统媒体控制（桌面播放控件）"
                                  OnContent="启用" OffContent="停用" Toggled="OnSystemMediaToggled" />
                    <ToggleSwitch x:Name="RememberWindowSwitch" Header="记住窗口位置与大小"
                                  OnContent="启用" OffContent="停用" Toggled="OnRememberWindowToggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="诊断" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <ToggleSwitch x:Name="VerboseSwitch" Header="记录详细日志（调试）"
                                  OnContent="启用" OffContent="停用" Toggled="OnVerboseToggled" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开日志目录" Click="OnOpenLogFolder" />
                        <Button Content="恢复默认设置" Click="OnResetSettings" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,0" />
                    <TextBlock Text="iOpenPod 管理器（C# / WinUI 3 重制版）" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="这是一个完全使用 C# 与 WinUI 3 重写的开源 iPod 管理工具，界面与日志均为中文。支持 iPod（第 1–5.5 代）、iPod classic、iPod mini 与 iPod nano 全系列的文件系统级管理。iPod shuffle、iPod touch 与 iPhone 不在支持范围内。" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="原始项目：https://github.com/TheRealSavi/iOpenPod　授权：GPL-3.0-or-later。iPod 与 iTunes 是 Apple Inc. 的商标，本软件与 Apple 无任何关联。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
