<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="同步" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="从电脑上的媒体文件夹把音乐、视频与封面同步到 iPod。移除项默认不勾选，确认前不会写入任何内容。" />
            </StackPanel>
        </Grid>

        <controls:InfoBar x:Name="NoticeBar" Grid.Row="1" Margin="0,0,0,12"
                          IsOpen="False" IsClosable="True" Severity="Informational" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel Spacing="10">
                <TextBlock Text="媒体来源文件夹" FontWeight="SemiBold" />
                <ListView x:Name="FolderList" Height="120" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Padding="2,6,2,6" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="OnAddFolderClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="添加文件夹" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnRemoveFolderClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE738;" FontSize="13" />
                            <TextBlock Text="移除所选" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScanButton" Click="OnScanClick" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                            <TextBlock Text="扫描并生成计划" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunButton" Click="OnRunSyncClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE895;" FontSize="13" />
                            <TextBlock Text="执行同步" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ProgressBar x:Name="ScanProgress" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
                <TextBlock x:Name="ScanStatus" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="12,12,12,6" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="新增" FontWeight="SemiBold" />
                        <TextBlock x:Name="AddCount" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                        <Button Click="OnSelectAllAdds" Padding="6,2,6,2" FontSize="11" HorizontalAlignment="Right">
                            <TextBlock Text="全选" />
                        </Button>
                    </StackPanel>
                    <ListView x:Name="AddList" Grid.Row="1" ItemTemplate="{StaticResource SyncChangeTemplate}"
                              SelectionMode="None" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="12,12,12,6" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="更新" FontWeight="SemiBold" />
                        <TextBlock x:Name="UpdateCount" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="UpdateList" Grid.Row="1" ItemTemplate="{StaticResource SyncChangeTemplate}"
                              SelectionMode="None" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="12,12,12,6" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="移除（默认不勾选）" FontWeight="SemiBold" />
                        <TextBlock x:Name="RemoveCount" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="RemoveList" Grid.Row="1" ItemTemplate="{StaticResource SyncChangeTemplate}"
                              SelectionMode="None" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
