<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IOpenPod.WinUI.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="播放列表" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" Text="尚未加载设备。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Click="OnCreatePlaylistClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="新建播放列表" />
                    </StackPanel>
                </Button>
                <Button Click="OnRenamePlaylistClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8AC;" FontSize="13" />
                        <TextBlock Text="重命名" />
                    </StackPanel>
                </Button>
                <Button Click="OnDeletePlaylistClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="我的播放列表" FontWeight="SemiBold" Margin="12,12,12,6" />
                    <ListView x:Name="PlaylistList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="OnPlaylistSelectionChanged" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Padding="4,8,4,8">
                                    <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Name="DetailName" FontSize="20" FontWeight="SemiBold" Text="未选择播放列表" />
                            <TextBlock x:Name="DetailMeta" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="OnPlayPlaylistClick" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                    <TextBlock Text="播放" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnAddTracksClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="添加曲目…" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnRemoveFromPlaylistClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE738;" FontSize="13" />
                                    <TextBlock Text="移出列表" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListView x:Name="DetailTracks" Grid.Row="1" ItemTemplate="{StaticResource TrackRowTemplate}"
                          SelectionMode="Extended" IsItemClickEnabled="True" DoubleTapped="OnTrackDoubleTapped">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="立即播放" Click="OnTrackPlayClick" />
                            <MenuFlyoutItem Text="添加到队列" Click="OnTrackEnqueueClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="移出该播放列表" Click="OnRemoveFromPlaylistClick" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
