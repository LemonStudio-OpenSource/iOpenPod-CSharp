<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iOpenPod.Verification</AssemblyName>
    <RootNamespace>DbCheck</RootNamespace>
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1822;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\iOpenPod.IPodDb\iOpenPod.IPodDb.csproj" />
    <ProjectReference Include="..\..\src\iOpenPod.DeviceRegistry\iOpenPod.DeviceRegistry.csproj" />
    <ProjectReference Include="..\..\src\iOpenPod.App\iOpenPod.App.csproj" />
  </ItemGroup>

</Project>
